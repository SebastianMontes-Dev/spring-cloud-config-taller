{
  "info": {
    "name": "Taller Spring Cloud Config",
    "description": "Pruebas del taller: Config Server (puerto 8888) y Config Client loan-service (8081 default, 8082 dev, 8083 uat).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Config Server (8888)",
      "item": [
        {
          "name": "Server - loan-service/default",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Perfil default con puerto 8081', () => {",
                  "  const src = pm.response.json().propertySources[0].source;",
                  "  pm.expect(src['server.port']).to.eql('8081');",
                  "  pm.expect(src['application.message']).to.eql('Welcome From Default Profile');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8888/loan-service/default",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8888",
              "path": ["loan-service", "default"]
            }
          }
        },
